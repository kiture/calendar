{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@shared/types": ["../frontend/src/types"],
      "@shared/types/*": ["../frontend/src/types/*"]
    }
  },
  "include": ["src/**/*.ts", "../frontend/src/types/db.types.ts"],
  "exclude": ["node_modules"]
}
